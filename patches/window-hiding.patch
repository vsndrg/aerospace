-enum OptimalHideCorner {
-    case bottomLeftCorner, bottomRightCorner
+// Patch (hide corner): the top corners hide a window beside the monitor, top
+// aligned with its visible area, for a monitor with another one right below it.
+// Case order = preference on a tie.
+enum OptimalHideCorner: CaseIterable {
+    case bottomRightCorner, bottomLeftCorner, topRightCorner, topLeftCorner
+
+    /// Top-left point of a window of `size` hidden in this corner of `rect`,
+    /// with `offset` points of it left inside `rect`
+    func hiddenTopLeft(in rect: Rect, size: CGSize, offset: CGFloat) -> CGPoint {
+        switch self {
+            case .bottomRightCorner: CGPoint(x: rect.maxX - offset, y: rect.maxY - offset)
+            case .bottomLeftCorner: CGPoint(x: rect.minX - size.width + offset, y: rect.maxY - offset)
+            case .topRightCorner: CGPoint(x: rect.maxX - offset, y: rect.minY)
+            case .topLeftCorner: CGPoint(x: rect.minX - size.width + offset, y: rect.minY)
+        }
+    }
 }
 
