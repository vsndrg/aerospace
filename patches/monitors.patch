+extension Workspace {
+    /// Patch (monitors): where this workspace belongs, even while that monitor is
+    /// disconnected (workspaceMonitor approximates a missing monitor by the nearest one).
+    @MainActor
+    var homeMonitorPoint: CGPoint {
+        visibleWorkspaceToScreenPoint[self]
+            ?? (isEffectivelyEmpty ? nil : assignedMonitorPoint)
+            ?? workspaceMonitor.rect.topLeftCorner
+    }
+
+    /// Patch (monitors): re-home a hidden workspace to a monitor that may be absent.
+    @MainActor
+    func setHomeMonitorPoint(_ point: CGPoint) {
+        if !isVisible { assignedMonitorPoint = point }
+    }
+
+    /// Patch (monitors): shown on `screen`, but its own monitor is one of `screens`.
+    @MainActor
+    fileprivate func isAwayFromHome(at screen: CGPoint, among screens: [CGPoint]) -> Bool {
+        guard let home = assignedMonitorPoint else { return false }
+        return home != screen && screens.contains(home)
+    }
+}
