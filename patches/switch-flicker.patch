+/// Waits until every given app has run its queued AX jobs, or the timeout hits
+/// (a hung app must never block workspace switching).
+@MainActor
+private func drainAxQueues(_ apps: [MacApp], timeoutMs: UInt64) async {
+    if apps.isEmpty { return }
+    final class Once { var done = false }
+    let once = Once()
+    await withCheckedContinuation { (cont: CheckedContinuation<Void, Never>) in
+        @MainActor func finish() {
+            if once.done { return }
+            once.done = true
+            cont.resume()
+        }
+        Task { @MainActor in
+            for app in apps { await app.drainAxQueue() }
+            finish()
+        }
+        Task { @MainActor in
+            try? await Task.sleep(nanoseconds: timeoutMs * 1_000_000)
+            finish()
+        }
+    }
+}
